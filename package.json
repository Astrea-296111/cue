{
  "name": "cue",
  "version": "0.2.2",
  "description": "实时 AI 面试辅助工具",
  "license": "GPL-3.0-or-later",
  "author": "cue",
  "main": "src/custom-main.js",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/test-essential.cjs",
    "test:ui": "electron test/core-ui-smoke.cjs",
    "test:protection": "electron test/windows-capture-protection-smoke.cjs",
    "dist": "electron-builder --mac",
    "dist:linux": "electron-builder --linux --x64",
    "dist:linux:arm64": "electron-builder --linux --arm64",
    "prepare:whisper": "node scripts/prepare-whisper-runtime-fixed.js",
    "pack:win": "electron-builder --win --dir",
    "postinstall": "node scripts/rename-electron.js",
    "dist:win": "electron-builder --win portable",
    "dist:win:installer": "electron-builder --win nsis",
    "test:semantic": "node scripts/semantic-smoke.cjs",
    "test:semantic:runtime": "node scripts/semantic-smoke.cjs --runtime-only",
    "eval:rag": "node scripts/evaluate-rag.js",
    "benchmark:rag": "node scripts/evaluate-rag.js --benchmark",
    "eval:rag:semantic": "node scripts/evaluate-rag.js --semantic",
    "verify:whisper-runtime": "node scripts/verify-whisper-runtime.js",
    "compile:project-packs": "node scripts/compile-project-packs.js",
    "benchmark:providers": "node scripts/benchmark-providers.js",
    "benchmark:materials": "node scripts/benchmark-project-materials.js",
    "verify:materials": "node scripts/verify-project-materials.js",
    "compile:materials": "node scripts/bundle-project-materials.cjs",
    "sync:sources": "node scripts/sync-project-sources.cjs --refresh",
    "prepare:personal": "node scripts/prepare-personal-workspace.cjs",
    "start:personal": "node scripts/start-personal.cjs",
    "test:llm:live": "node scripts/e2e-live-llm.cjs",
    "test:llm:mock": "node scripts/e2e-live-llm.cjs --mock",
    "eval:remote": "node scripts/eval-remote.cjs",
    "eval:public": "node scripts/eval-public.cjs"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "^26.15.3",
    "extract-zip": "^2.0.1",
    "resedit": "^3.0.2",
    "tar": "^7.5.22"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@google/genai": "^2.12.0",
    "@huggingface/transformers": "3.8.1",
    "koffi": "3.3.3",
    "lucide-static": "^0.468.0",
    "mammoth": "^1.8.0",
    "openai": "^4.73.0",
    "pdf-parse": "^1.1.1",
    "ws": "^8.18.0"
  }
}
