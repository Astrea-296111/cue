{
  "name": "cue",
  "version": "0.2.2",
  "description": "Realtime AI interview assistant",
  "license": "GPL-3.0-or-later",
  "author": "cue",
  "main": "src/custom-main.js",

  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "test:ui": "electron test/renderer-layout-smoke.cjs",
    "dist": "electron-builder --mac",
    "dist:linux": "electron-builder --linux --x64",
    "dist:linux:arm64": "electron-builder --linux --arm64",

    "prepare:whisper": "node scripts/prepare-whisper-runtime-fixed.js",

    "pack:win": "electron-builder --win --dir",
    "postinstall": "node scripts/rename-electron.js",
    "dist:win": "electron-builder --win portable",

    "dist:win:installer": "electron-builder --win nsis"
  },

  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "^26.15.3",
    "extract-zip": "^2.0.1",
    "resedit": "^3.0.2",
    "tar": "^7.5.22"
  },

  "engines": {
    "node": ">=22.12.0"
  },

  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@google/genai": "^2.12.0",
    "lucide-static": "^0.468.0",
    "mammoth": "^1.8.0",
    "openai": "^4.73.0",
    "pdf-parse": "^1.1.1",
    "ws": "^8.18.0"
  }
}




