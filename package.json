{
  "name": "cue",
  "version": "0.2.2",
  "description": "Realtime AI interview assistant",
  "license": "GPL-3.0-or-later",
  "author": "cue",
  "main": "src/custom-main.js",

  "scripts": {
    "start": "electron .",

    "prepare:whisper": "node scripts/prepare-whisper-runtime-fixed.js",

    "pack:win": "electron-builder --win --dir",
    "postinstall": "node scripts/rename-electron.js",
    "dist:win": "electron-builder --win portable",

    "dist:win:installer": "electron-builder --win nsis"
  },

  "build": {
  "appId": "com.cue.assistant",
  "productName": "Cue",
  "asar": true,

  "files": [
    "main.js",
    "preload.js",
    "src/**/*",
    "renderer/**/*",
    "vendor/**/*",
    "package.json",
    "node_modules/**/*"
  ],

  "extraResources": [
    {
      "from": ".cache/whisper-runtime/win32-x64",
      "to": "whisper-runtime",
      "filter": [
        "**/*"
      ]
    }
  ],

  "win": {
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "Cue-${version}-portable.${ext}"
  }
},

  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "^26.15.3",
    "extract-zip": "^2.0.1",
    "resedit": "^0.0.1",
    "tar": "^7.5.22"
  },

  "engines": {
    "node": ">=22.12.0"
  },

  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@google/genai": "^2.12.0",
    "lucide-static": "^0.468.0",
    "mammoth": "^1.8.0",
    "openai": "^4.73.0",
    "pdf-parse": "^1.1.1",
    "ws": "^8.18.0"
  }
}




